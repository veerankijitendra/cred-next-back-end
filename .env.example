# Copy to .env for local development and replace the database URL placeholder.
# Never use this example as a production secret.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/crednexa
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=crednexa-api
JWT_AUDIENCE=crednexa-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
OTP_RATE_LIMIT=5
REFRESH_RATE_LIMIT=20